# Copia este ficheiro para .env e substitui pela tua chave verdadeira.
# .env está no .gitignore, por isso nunca é commitado; este .env.example é
# só para quem clonar o repositório saber que variável definir.
#
# Chave da API da NVIDIA (build.nvidia.com), usada por chat.py / mnemo/modelo_nvidia.py
NVIDIA_API_KEY=nvapi-a-tua-chave-aqui
