# Copia este ficheiro para .env e substitui pela tua chave verdadeira.
# .env está no .gitignore, por isso nunca é commitado; este .env.example é
# só para quem clonar o repositório saber que variável definir.
#
# Chave da API da NVIDIA (build.nvidia.com), usada por chat.py / mnemo/modelo_nvidia.py
NVIDIA_API_KEY=nvapi-a-tua-chave-aqui

# Modelo a usar para chat (padrão: nvidia/nemotron-3.5-lightning-30b-a3b)
# Exemplos: nvidia/nemotron-3-ultra, nvidia/nemotron-4-340b-instruct, nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Modelo a usar para embeddings (padrão: nvidia/nemotron-3.5-embed-1b)
# Exemplos: nvidia/nemotron-3-embed-1b, nvidia/nemotron-3.5-embed-8b, nvidia/nv-embedqa-mistral-7b-v2
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
